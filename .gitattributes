# Stable text normalization; preserve source planning bytes and line endings.
* text=auto
/Planning/** -text
/ArtSource/Fonts/CormorantGaramond/OFL.txt -text whitespace=-blank-at-eol
/ArtSource/Licenses/ROBOTO_License.txt -text whitespace=-blank-at-eol
.gitkeep -text

# Keep the new badge master/runtime bytes stable across checkout platforms.
/ArtSource/UI/G/Vector/G-Answer-Badge-v001.svg text eol=lf
/Game/Content/UI/G/Vector/G_AnswerBadge.svg text eol=lf

# Preserve exact staged bytes for the revised wordmark candidate.
/ArtSource/UI/G/Vector/G-Wordmark-v002.svg text eol=lf
/Game/Content/UI/G/Vector/G_Wordmark.svg text eol=lf

# Keep the revised divider masters and staged copies byte-identical.
/ArtSource/UI/G/Vector/G-Header-Divider-v002.svg text eol=lf
/ArtSource/UI/G/Vector/G-Reading-Divider-v002.svg text eol=lf
/Game/Content/UI/G/Vector/G_HeaderDivider.svg text eol=lf
/Game/Content/UI/G/Vector/G_ReadingDivider.svg text eol=lf

# Unreal binary assets.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text

