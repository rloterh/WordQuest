# Stable text normalization; preserve source planning bytes and line endings.
* text=auto
/Planning/** -text
.gitkeep -text

# Unreal binary assets.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text

